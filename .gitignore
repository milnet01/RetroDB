# =============================================================================
# RetroDB .gitignore
# =============================================================================

# Personal configuration (contains API keys, paths, credentials)
config.py
data/scraper_settings.json
data/settings.json
data/retroarch-overrides.cfg
data/retroarch-overrides-keyboard.cfg
data/player/
data/rom_tools_config.json
data/.secret_key

# OAuth tokens (auto-generated at runtime, contain JWTs / refresh tokens)
data/psn_tokens.json
data/xbox_tokens.json
# Kept after migration 015 ingests them (Pass 59.44); still plaintext tokens
data/psn_tokens.json.migrated-015
data/xbox_tokens.json.migrated-015

# Archives moved aside by Create M3U (PASS-59-119)
data/m3u_staging/

# HLTB dataset (large CSV, downloaded on demand)
data/hltb_dataset.csv

# Self-updater state and work folder (PASS-59-169)
data/update_check.json
data/update_status.json
.update/

# PSN credentials
docs/psn-npsso.env

# Database files
database/*.db
database/*.db-journal
database/*.db-wal
database/*.db-shm

# Pass 41.6 — runtime-created job singleton lock files (per-process state)
database/job_locks/
database/*.db.bak*

# Runtime DB backups (auto-generated by the app, e.g. roms_backup_<ts>.db)
database/backups/

# Log files
logs/*.log

# Scraped/user-uploaded media (downloaded during use).
# Whitelist matches build_dist.py INCLUDE_IMAGE_DIRS: hardware, ratings, systems, avatars.
static/images/*
!static/images/hardware/
!static/images/ratings/
!static/images/systems/
!static/images/avatars/
!static/images/placeholder.png
# App icons beside per-user PSN trophy art; mirrors build_dist.py INCLUDE_IMAGE_FILES.
!static/images/trophies/
static/images/trophies/*
!static/images/trophies/bronze.png
!static/images/trophies/silver.png
!static/images/trophies/gold.png
!static/images/trophies/platinum.png
!static/images/trophies/default_trophy.png
!static/images/trophies/clz-games-web.svg
!static/images/trophies/psn.png
!static/images/trophies/ra.webp
!static/images/trophies/rpcs3.png
!static/images/trophies/steam.png
!static/images/trophies/xbox.png
static/videos/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual environments
venv/
.venv/
env/

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Demo/test data
demo/

# Backups (user-generated)
backups/*.zip
*.bak

# Claude Code local permissions + runtime locks (per-user, should not be shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Ruff cache
.ruff_cache/

# Audit tool output (generated by /audit skill runs, not source)
.audit_cache/
audit_rule_quality.json

# Review-skill output + Ants-MCP tooling state (generated, per-user, not source)
.cold-eyes-reports/
.roadmap-counter

# Other Python tool caches
.pytest_cache/
.mypy_cache/
.tox/
.nox/

# Coverage output (for upcoming pytest-cov in CI — Pass 20.3)
.coverage
.coverage.*
coverage.xml
htmlcov/

# Environment / dotenv files (secrets safety net — should never be committed)
.env
.env.local
.env.*.local

# TLS / signing material (safety net — real keys would never belong in-repo)
*.pem
*.key
*.crt
*.pfx
*.p12

# KDE Dolphin per-folder view metadata
.directory

# Retired RetroDB material, moved in from /mnt/Games/Scripts/Linux on 2026-10-15. Not shipped.
.archive/
