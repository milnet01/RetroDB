#: templates/rom_tools_hub.html:182
msgid ""
"Find duplicate ROMs by hash, filename, or both. Identify wasted storage "
"from region variants and redundant copies."
msgstr ""
"Finn duplikat-ROM-er etter hash, filnavn, eller begge deler. Identifiser "
"bortkastet lagringsplass fra regionvarianter og overflødige kopier."

