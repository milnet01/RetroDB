#: templates/_settings_tabs/system.html:155
#, python-format
msgid "This is RetroDB %(version)s."
msgstr "Questo è RetroDB %(version)s."

#: templates/_settings_tabs/system.html:159
msgid ""
"Version 4.0 is the last web version of RetroDB. New versions will be a "
"desktop app for Windows, Linux and macOS, and an Android app. They will "
"open your existing library. Until then, version 4.0 gets only security "
"fixes and fixes for bugs that lose data."
msgstr ""
"La versione 4.0 è l'ultima versione web di RetroDB. Le nuove versioni "
"saranno un'app desktop per Windows, Linux e macOS e un'app per Android. "
"Apriranno la tua Libreria esistente. Fino ad allora, la versione 4.0 "
"riceverà solo correzioni di sicurezza e correzioni di bug che causano "
"perdita di dati."

