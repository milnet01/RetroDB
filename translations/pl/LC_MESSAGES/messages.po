#: templates/settings_emulators.html:37
msgid ""
"RetroArch needs explicit binary + cores-dir paths because they typically "
"live in different prefixes (system package, ~/.local, or a Flatpak "
"sandbox)."
msgstr ""
"RetroArch wymaga jawnych ścieżek do pliku wykonywalnego i katalogu "
"rdzeni, ponieważ zwykle znajdują się one w różnych lokalizacjach (pakiet "
"systemowy, ~/.local lub piaskownica Flatpak)."

