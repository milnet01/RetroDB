msgstr "Organizador de Jogos de Múltiplos Discos"

#: templates/multi_disc_organizer.html:172
msgid "What This Tool Does"
msgstr "O Que Esta Ferramenta Faz"

#: templates/multi_disc_organizer.html:174
msgid ""
"Scans for multi-disc game files (Disc 1, Disc 2, etc.) that aren't "
"properly organized"
msgstr ""
"Verifica arquivos de jogos com múltiplos discos (Disco 1, Disco 2, etc.) "
"que não estão devidamente organizados"

#: templates/multi_disc_organizer.html:175
msgid "Creates a folder for each game with the disc files inside"
msgstr "Cria uma pasta para cada jogo com os arquivos de disco dentro"

#: templates/multi_disc_organizer.html:176
msgid ""
"Adds a <code>noload.txt</code> file to prevent ES-DE from scanning "
"individual discs"
msgstr ""
