msgid "ROM Naming Conventions"
msgstr "Convenções de nomenclatura de ROM"

#: templates/_settings_tabs/library.html:176
msgid ""
"Configure the filename pattern for each system type. Title is always first.\n"
"            Add tags in the order they should appear in filenames (e.g., <code>Title (Region).zip</code>)."
msgstr ""
"Configure o padrão de nome de arquivo para cada tipo de sistema. O título sempre vem primeiro.\n"
"            Adicione as tags na ordem em que devem aparecer nos nomes dos arquivos (ex.: <code>Title (Region).zip</code>)."

#: templates/_settings_tabs/library.html:181
msgid "Article Placement"
msgstr "Posicionamento de artigos"

#: templates/_settings_tabs/library.html:183
msgid "Controls where articles (A, An, The) appear in game titles and ROM filenames."
msgstr "Controla onde os artigos (A, An, The) aparecem nos títulos dos jogos e nos nomes de arquivos de ROM."

#: templates/_settings_tabs/library.html:186
msgid "Beginning (natural) — \"The Legend of Zelda\""
msgstr "Início (natural) — \"The Legend of Zelda\""

#: templates/_settings_tabs/library.html:187
msgid "End (sort-friendly) — \"Legend of Zelda, The\""
msgstr "Fim (ideal para ordenação) — \"Legend of Zelda, The\""

#: templates/_settings_tabs/library.html:189
msgid "Applies to new scrapes and rename suggestions. Existing titles are not changed automatically."
msgstr "Aplica-se a novos scrapings e sugestões de renomeação. Os títulos existentes não são alterados automaticamente."

#: templates/_settings_tabs/library.html:193
msgid "Region Options"
msgstr "Opções de região"

#: templates/_settings_tabs/library.html:195
msgid "Configure the available region values and default. The default region is used when scraping if no region is detected."
msgstr "Configure os valores de região disponíveis e o padrão. A região padrão é usada durante o scraping se nenhuma região for detectada."

