msgstr ""
"Додайте власний ключ Steam і Steam ID, щоб імпортувати свою бібліотеку та"
" досягнення Steam."

#: templates/_settings_tabs/account.html:238
msgid ""
"Get your key from <a href=\"https://steamcommunity.com/dev/apikey\" "
"target=\"_blank\" rel=\"noopener noreferrer\" style=\"color: var"
"(--primary-cyan);\">Steam's API key page</a>"
msgstr ""
"Отримайте ключ на <a href=\"https://steamcommunity.com/dev/apikey\" "
"target=\"_blank\" rel=\"noopener noreferrer\" style=\"color: var"
"(--primary-cyan);\">сторінці ключів API Steam</a>"

#: templates/_settings_tabs/account.html:242
msgid "Your Steam ID"
msgstr "Ваш Steam ID"

#: templates/_settings_tabs/account.html:246
#: templates/_settings_tabs/scraping.html:356
