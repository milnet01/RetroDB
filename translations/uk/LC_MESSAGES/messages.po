msgstr "Розташування бази даних"

#: templates/_settings_tabs/library.html:32
msgid "Database path cannot be changed via UI"
msgstr "Шлях до бази даних не можна змінити через інтерфейс"

#: templates/_settings_tabs/library.html:38
msgid "Save Path Settings"
msgstr "Зберегти налаштування шляхів"

#: templates/_settings_tabs/library.html:46
msgid "Changes to ROM path require a restart to take full effect"
msgstr "Зміни шляху ROM потребують перезапуску для повного набуття чинності"

