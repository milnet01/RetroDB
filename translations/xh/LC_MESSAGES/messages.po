#: templates/_settings_tabs/system.html:206
msgid "Logging Settings"
msgstr "Iisethingi Zokurekhoda"

#: templates/_settings_tabs/system.html:210
#, python-format
msgid ""
"Configure which log levels are written to log files. Logs are saved to "
"the %(folder)s folder with date-based filenames (e.g., %(example)s)."
msgstr ""
"Misela ukuba ngawaphi amanqanaba elog abhalwa kwiifayile zelog. Iilogi "
"zigcinwa kwifolda ethi %(folder)s ngamagama eefayile asekelwe kumhla "
"(umz., %(example)s)."

